  "script": "\nfunction canon(v){if(v===figma.mixed)return \"MIXED\";if(Array.isArray(v))return v.map(canon);if(v&&typeof v==='object'){let o={};for(const k of Object.keys(v).sort()){if(k==='boundVariables')continue;o[k]=canon(v[k]);}return o;}return v;}\nfunction hash(s){let a=2166136261,b=5381;for(let i=0;i<s.length;i++){a=Math.imul(a^s.charCodeAt(i),16777619);b=Math.imul(b,33)^s.charCodeAt(i);}return[(a>>>0).toString(16),(b>>>0).toString(16)].join('-');}\nconst fields=['name','type','width','height','visible','locked','opacity','blendMode','fills','strokes','strokeWeight','strokeAlign','strokeCap','strokeJoin','dashPattern','effects','cornerRadius','cornerSmoothing','topLeftRadius','topRightRadius','bottomLeftRadius','bottomRightRadius','clipsContent','isMask','maskType','layoutMode','layoutWrap','primaryAxisSizingMode','counterAxisSizingMode','primaryAxisAlignItems','counterAxisAlignItems','itemSpacing','paddingTop','paddingRight','paddingBottom','paddingLeft','layoutGrow','layoutAlign','layoutPositioning','constraints','vectorPaths','vectorNetwork','exportSettings','reactions'];\nfunction inspect(root){let records=[],ids=[],bindings=[],images=new Set(),errs=[];function w(n,path){let o={path};ids.push(n.id);for(const f of fields){try{if(f in n)o[f]=canon(n[f]);}catch(e){errs.push({id:n.id,field:f,error:String(e)});}}if(path!=='')o.relativeTransform=canon(n.relativeTransform);if('boundVariables'in n&&Object.keys(n.boundVariables||{}).length)bindings.push(n.id);for(const f of ['fills','strokes'])if(f in n&&Array.isArray(n[f]))for(const p of n[f])if(p.type==='IMAGE')images.add(p.imageHash);if(n.type==='INSTANCE')o.properties=canon(n.componentProperties);records.push(o);if('children'in n)n.children.forEach((c,i)=>w(c,path+'/'+i));}w(root,'');const s=JSON.stringify(records);return{id:root.id,count:records.length,digest:hash(s),canonicalLength:s.length,bindings,images:[...images].sort(),errors:errs};}\n",
