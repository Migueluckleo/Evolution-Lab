#!/bin/sh
set -eu
ds_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ds_python=${DS_PYTHON:-}
if [ -z "$ds_python" ] && [ -f "$ds_root/graphify-out/.graphify_python" ]; then
  ds_python=$(cat "$ds_root/graphify-out/.graphify_python")
fi
if [ -z "$ds_python" ] || [ ! -x "$ds_python" ]; then
  ds_python=$(command -v python3 || true)
fi
if [ -z "$ds_python" ]; then
  echo 'Python no disponible. Define DS_PYTHON con un intérprete existente.' >&2
  exit 2
fi
exec "$ds_python" -B "$ds_root/scripts/ds.py" "$@"
