{
  "schema_version": 1,
  "initial_version": "0.1.0",
  "output": "output/skills",
  "skills": [
    "contpaqi-figma-screens",
    "contpaqi-po-prototypes"
  ],
  "include": [
    "AGENTS.md",
    "protocols/**",
    "specs/**",
    "drafts/contracts/**",
    "drafts/foundations/**",
    "sources/inventories/**",
    "sources/figma-snapshots/**",
    "sources/assets/**",
    "implementations/figma/**",
    "registry/*.md",
    "qa/contracts/**",
    "qa/implementations/**",
    "implementations/web/src/components/**",
    "implementations/web/src/lib/**",
    "implementations/web/src/generated/**",
    "implementations/web/src/index.ts",
    "implementations/web/src/styles.css",
    "implementations/web/public/assets/**",
    "implementations/web/docs/**",
    "implementations/web/components.registry.json",
    "implementations/web/package.json",
    "implementations/web/pnpm-lock.yaml"
  ],
  "exclude": [
    "registry/skills*",
    "registry/skill-releases*",
    "registry/SESSION-HANDOFF-*",
    "registry/generated/**",
    "qa/skills/**",
    "qa/tooling/**",
    "qa/implementations/web*.png",
    "qa/implementations/web*/**/*.png",
    "qa/implementations/web*/**/*.webp",
    "graphify-out/**",
    "output/**",
    "archive/**",
    ".codex/**",
    ".git/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/.pnpm-store/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.DS_Store",
    ".DS_Store"
  ],
  "link_dependency_roots": [
    "specs",
    "drafts",
    "sources",
    "implementations/figma",
    "registry",
    "qa",
    "protocols",
    "references",
    "templates"
  ],
  "link_dependency_files": [
    "README.md",
    "CHANGELOG.md",
    "PACKAGE-VERIFICATION.md",
    "MIGRATION-v0.2.0.md"
  ],
  "excluded_link_reason": "Referenced maintenance, historical, generated or out-of-snapshot material; no content or validation is inferred.",
  "authority": "DERIVED_CONSUMER_SNAPSHOT; source contracts retain their states; packaging does not approve design, Figma or web QA.",
  "delivery": "github-live-v1"
}
